super + shift + q
	bspc quit

super + r
	bspc wm -r

@super + q
	bspc node -c

@super + e
	lxterminal

@super + w
	librewolf-bin

super + t
	bspc node -t tiled

super + f
	bspc node -t floating

super + shift + f
	bspc node -t fullscreen

alt + {Up, Down, Left, Right}
	bspc node -f {north, south, west, east}

super + {Left, Right}
	bspc desktop -f {prev, next}

