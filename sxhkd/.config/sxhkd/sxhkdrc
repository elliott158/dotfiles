super + shift + q
	bspc quit

super + r
	bspc wm -r

super + q
	bspc node -c

super + e
	st

super + w
	librewolf-bin

super + {shift + t, shift + f}
	bspc node -t {tiled, fullscreen}

alt + {Up, Down, Left, Right}
	bspc node -f {north, south, west, east}

super + {Left, Right}
	bspc desktop -f {prev, next}

